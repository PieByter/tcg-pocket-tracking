# --- Supabase Postgres (production) ---------------------------------------
# Connection pooling / transaction mode, port 6543. Wajib untuk Vercel.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection, port 5432. Dipakai drizzle-kit untuk migrasi.
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Auth -----------------------------------------------------------------
# Password halaman login (satu pengguna).
APP_PASSWORD="ganti-password-ini"
# Random string >= 16 karakter untuk menandatangani cookie sesi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-random-string-panjang"

# --- Opsional -------------------------------------------------------------
# 1 = izinkan PGlite (file lokal) saat NODE_ENV=production. Jangan dipakai di Vercel.
# ALLOW_LOCAL_DB="0"
# Lokasi file database lokal (default: .data/pocketledger).
# PGLITE_DATA_DIR=".data/pocketledger"
