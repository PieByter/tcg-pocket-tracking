# --- Supabase Auth (wajib) ------------------------------------------------
# Project Settings → API: Project URL dan anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# --- Supabase Postgres (wajib) --------------------------------------------
# Pakai pooler (IPv4) untuk keduanya. Host direct db.<project-ref>.supabase.co
# hanya punya record AAAA (IPv6), jadi gagal di jaringan IPv4-only.
# Transaction mode, port 6543 — dipakai aplikasi (prepare: false).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Session mode, port 5432 — dipakai drizzle-kit untuk migrasi.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Opsional -------------------------------------------------------------
# Email user yang sudah terdaftar, dipakai `npm run db:seed` dan `npm run db:migrate:local`.
# SEED_USER_EMAIL="you@example.com"
# Khusus mode PGlite tanpa Supabase Auth: UUID user yang akan memiliki data seed.
# SEED_USER_ID="00000000-0000-0000-0000-000000000000"
# Domain publik untuk link konfirmasi email (default: origin request).
# NEXT_PUBLIC_SITE_URL="https://pocketledger.example.com"
# 1 = izinkan PGlite (file lokal) saat NODE_ENV=production. Jangan dipakai di Vercel.
# ALLOW_LOCAL_DB="0"
# Lokasi file database lokal (default: .data/pocketledger).
# PGLITE_DATA_DIR=".data/pocketledger"
# 1 = aktifkan optimizer gambar Next (butuh kuota Vercel). Default: 0 (pakai thumbnail CDN langsung).
# NEXT_IMAGE_OPTIMIZED="0"
